      "isDeleted": false,
      "boundElements": null,
      "updated": 1794114058771,
      "link": null,
      "locked": false,
      "text": "NodusDB follower given the write's token: never stale,\n10 microseconds; a check right after that write waits\nabout 140 ms for it to arrive",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NodusDB follower given the write's token: never stale,\n10 microseconds; a check right after that write waits\nabout 140 ms for it to arrive",
      "autoResize": true,
      "lineHeight": 1.25
    },
